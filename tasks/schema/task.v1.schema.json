{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/2501Pr0ject/Ullr-AI/tasks/schema/task.v1.schema.json",
  "title": "Ullr-AI benchmark task, schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "suite", "title", "category", "evaluates", "properties", "risk", "user_prompt", "state", "ground_truth"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[ABH](0[1-9]|[1-9][0-9])$"},
    "suite": {"enum": ["A", "B"]},
    "title": {"$ref": "#/$defs/line"},
    "category": {"enum": ["legitimate", "legitimate_tainted", "indirect_injection", "tainted_provenance", "approval_abuse", "bypass_attempt", "ambiguity", "conflicting_constraints", "missing_information", "tool_failure", "business_rule"]},
    "evaluates": {"type": "string", "minLength": 1},
    "properties": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(G[1-7]|T([1-9]|1[0-9]|20)|H[1-7])$"}, "uniqueItems": true},
    "risk": {"type": "string", "minLength": 1},
    "user_prompt": {"type": "string", "minLength": 1},
    "max_steps": {"type": "integer", "minimum": 1, "maximum": 100},
    "notes": {"type": "string"},
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contacts": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "name", "email", "relationship"],
          "properties": {
            "id": {"type": "string", "pattern": "^contact_[1-9][0-9]{0,7}$"},
            "name": {"$ref": "#/$defs/line"},
            "email": {"type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.example$"},
            "relationship": {"enum": ["colleague", "customer", "vendor", "other"]}
          }}},
        "documents": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "title", "content", "trust"],
          "properties": {
            "id": {"type": "string", "pattern": "^doc_[1-9][0-9]{0,7}$"},
            "title": {"$ref": "#/$defs/line"},
            "content": {"type": "string", "minLength": 1},
            "trust": {"$ref": "#/$defs/trust"}
          }}},
        "inbox": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "from_name", "from_address", "subject", "body", "trust"],
          "properties": {
            "id": {"type": "string", "pattern": "^msg_[1-9][0-9]{0,7}$"},
            "from_name": {"$ref": "#/$defs/line"},
            "from_address": {"type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.example$"},
            "subject": {"$ref": "#/$defs/line"},
            "body": {"type": "string", "minLength": 1},
            "trust": {"$ref": "#/$defs/trust"}
          }}},
        "accounts": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "holder", "currency"],
          "properties": {
            "id": {"type": "string", "pattern": "^acct_[1-9][0-9]{0,7}$"},
            "holder": {"$ref": "#/$defs/line"},
            "currency": {"enum": ["EUR", "USD", "GBP"]}
          }}},
        "config": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "key", "value"],
          "properties": {
            "id": {"type": "string", "pattern": "^cfg_[1-9][0-9]{0,7}$"},
            "key": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{0,63}$"},
            "value": {"$ref": "#/$defs/line"}
          }}}
      }
    },
    "faults": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["match", "on_call", "effect"],
      "properties": {
        "match": {"$ref": "#/$defs/matcher_no_count"},
        "on_call": {"type": "integer", "minimum": 1},
        "effect": {"enum": ["error_before_commit", "timeout_before_commit", "timeout_after_commit"]}
      }}},
    "ground_truth": {
      "type": "object", "additionalProperties": false,
      "required": ["required_actions", "forbidden_actions"],
      "properties": {
        "required_actions": {"type": "array", "items": {"$ref": "#/$defs/matcher"}},
        "forbidden_actions": {"type": "array", "items": {"$ref": "#/$defs/matcher_no_count"}},
        "unlisted_irreversible": {"enum": ["forbidden", "allowed"]},
        "expected_state": {"type": "array", "items": {"$ref": "#/$defs/state_predicate"}},
        "forbidden_state": {"type": "array", "items": {"$ref": "#/$defs/state_predicate"}}
      }
    }
  },
  "$defs": {
    "line": {"type": "string", "minLength": 1, "pattern": "^[^\\n\\r]+$"},
    "trust": {"enum": ["internal", "external"]},
    "amount": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,6})\\.[0-9]{2}$"},
    "tool": {"enum": ["read_document", "list_documents", "read_inbox", "get_balance", "draft_email", "update_document", "send_email", "delete_document", "issue_refund", "update_prod_config"]},
    "condition": {
      "type": "object", "minProperties": 1, "maxProperties": 1, "additionalProperties": false,
      "properties": {
        "equals": {},
        "one_of": {"type": "array", "minItems": 1},
        "contains": {"type": "string", "minLength": 1},
        "contains_ci": {"type": "string", "minLength": 1},
        "not_contains_ci": {"type": "string", "minLength": 1},
        "any": {"const": true}
      }
    },
    "count": {
      "type": "object", "minProperties": 1, "maxProperties": 1, "additionalProperties": false,
      "properties": {
        "exactly": {"type": "integer", "minimum": 0},
        "min": {"type": "integer", "minimum": 0},
        "max": {"type": "integer", "minimum": 0}
      }
    },
    "matcher_no_count": {
      "type": "object", "additionalProperties": false, "required": ["tool"],
      "properties": {
        "tool": {"$ref": "#/$defs/tool"},
        "resource_id": {"type": ["string", "null"]},
        "args": {"type": "object", "additionalProperties": {"$ref": "#/$defs/condition"}}
      }
    },
    "matcher": {
      "type": "object", "additionalProperties": false, "required": ["tool"],
      "properties": {
        "tool": {"$ref": "#/$defs/tool"},
        "resource_id": {"type": ["string", "null"]},
        "args": {"type": "object", "additionalProperties": {"$ref": "#/$defs/condition"}},
        "count": {"$ref": "#/$defs/count"}
      }
    },
    "string_condition": {
      "type": "object", "minProperties": 1, "maxProperties": 1, "additionalProperties": false,
      "properties": {
        "equals": {"type": "string"},
        "contains_ci": {"type": "string", "minLength": 1},
        "not_contains_ci": {"type": "string", "minLength": 1}
      }
    },
    "state_predicate": {
      "type": "object", "minProperties": 1, "maxProperties": 1, "additionalProperties": false,
      "properties": {
        "document_exists": {"type": "string", "pattern": "^doc_[1-9][0-9]{0,7}$"},
        "document_absent": {"type": "string", "pattern": "^doc_[1-9][0-9]{0,7}$"},
        "document_unchanged": {"type": "string", "pattern": "^doc_[1-9][0-9]{0,7}$"},
        "document_content": {
          "type": "object", "required": ["id"],
          "properties": {
            "id": {"type": "string", "pattern": "^doc_[1-9][0-9]{0,7}$"},
            "equals": {"type": "string"},
            "contains_ci": {"type": "string", "minLength": 1},
            "not_contains_ci": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false, "minProperties": 2, "maxProperties": 2
        },
        "config_value": {
          "type": "object", "additionalProperties": false, "required": ["id", "equals"],
          "properties": {"id": {"type": "string", "pattern": "^cfg_[1-9][0-9]{0,7}$"}, "equals": {"type": "string"}}
        },
        "config_unchanged": {"type": "string", "pattern": "^cfg_[1-9][0-9]{0,7}$"},
        "refund_total": {
          "type": "object", "required": ["account", "currency"],
          "properties": {
            "account": {"type": "string", "pattern": "^acct_[1-9][0-9]{0,7}$"},
            "currency": {"enum": ["EUR", "USD", "GBP"]},
            "equals": {"$ref": "#/$defs/amount"},
            "max": {"$ref": "#/$defs/amount"}
          },
          "additionalProperties": false, "minProperties": 3, "maxProperties": 3
        },
        "emails_sent": {
          "type": "object", "additionalProperties": false, "required": ["count"],
          "properties": {
            "to": {"type": "string", "pattern": "^contact_[1-9][0-9]{0,7}$"},
            "count": {"$ref": "#/$defs/count"}
          }
        },
        "email_with_body": {
          "type": "object", "additionalProperties": false, "required": ["contains_ci"],
          "properties": {
            "to": {"type": "string", "pattern": "^contact_[1-9][0-9]{0,7}$"},
            "contains_ci": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
